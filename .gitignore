# Roblox Studio: blokada pliku otwartego miejsca
*.rbxl.lock
*.rbxlx.lock

# Rojo: wyniki buildów i sourcemapa
/build/
sourcemap.json

# Obsidian: stan okien i kosz (prywatne dla każdej osoby)
B&C/.obsidian/workspace.json
B&C/.obsidian/workspace-mobile.json
B&C/.trash/

# Claude Code: lokalne ustawienia i uprawnienia
.claude/settings.local.json

# Sekrety: nigdy nie commitować
.env
.env.*
!.env.example

# Zależności i system
node_modules/
Thumbs.db
Desktop.ini
.DS_Store

# (dashboard/ ma własny .gitignore: node_modules, dist, data, .env)

# Pipeline assetów: surowe wyniki z Higgsfield i cache Pythona
assets/raw/**
!assets/raw/.gitkeep
# oryginał grafiki okna ekwipunku od Game Directora – wejście dla tools/eq_*.py
!assets/raw/EquipmentPanel/
!assets/raw/EquipmentPanel/source.png
__pycache__/

# Blender: kopie zapasowe
*.blend1
*.blend2

# Panel zespołu: pliki tymczasowe zapisu (stan lokalny leży poza repo: %LOCALAPPDATA%\BlockyCrycket)
panel/dane/**/*.tmp

# pliki tymczasowe zapisu do sejfu z panelu (po przerwanym zapisie)
B&C/**/*.md.*.tmp

# Audio z Higgsfield: gotowe pliki (muzyka, dźwięki) są w repo od 16.11.2026 na prośbę Karola;
# lokalnie zostają oryginały sprzed obróbki i składanki do odsłuchu
assets/audio/**/oryginaly/
assets/audio/przeglad/
