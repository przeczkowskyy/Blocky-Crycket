# Teksty: normalizacja końców linii
* text=auto

# Pliki binarne Roblox i grafiki: bez zmian i bez prób scalania
*.rbxl binary
*.rbxm binary
*.png binary
*.jpg binary
*.db binary
*.blend binary
*.glb binary

# Pliki wsadowe Windows muszą mieć końce linii CRLF
*.bat text eol=crlf
*.mp4 binary
*.fbx binary
