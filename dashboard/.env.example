# Skopiuj ten plik jako .env (w folderze dashboard/) i uzupełnij.
# Klucz jest czytany WYŁĄCZNIE przez serwer (server/), nigdy nie trafia do przeglądarki.

# Klucz Claude API (https://console.anthropic.com) — bez niego agenci mają status NOT CONFIGURED.
ANTHROPIC_API_KEY=

# Port backendu dashboardu (domyślnie 4310)
STUDIO_PORT=4310

# Opcjonalnie: Roblox Open Cloud (na razie tylko wykrywany w Integracjach)
ROBLOX_OPEN_CLOUD_API_KEY=
