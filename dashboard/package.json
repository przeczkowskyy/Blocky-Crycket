{
  "name": "blocky-crycket-ai-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "BLOCKY & CRYCKET — AI Development Studio (local dashboard for the Roblox project)",
  "scripts": {
    "dev": "node node_modules/concurrently/dist/bin/concurrently.js -k -n server,web -c yellow,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --disable-warning=ExperimentalWarning --watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "node node_modules/vite/bin/vite.js",
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.json && node node_modules/vite/bin/vite.js build",
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/index.ts",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@monaco-editor/react": "^4.6.0",
    "@xyflow/react": "^12.3.5",
    "express": "^4.21.1",
    "lucide-react": "^0.460.0",
    "monaco-editor": "^0.52.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
