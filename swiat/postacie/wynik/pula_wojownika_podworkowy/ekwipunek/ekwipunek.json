  ]
 },
 "upadek": {
  "klip": "upadek",
  "fps": 30,
  "zapas": 0.02,
  "przejscie": "a = clamp((klatka - od_klatki) / (do_klatki - od_klatki), 0, 1); C0 = C0_chwytu:Lerp(C0_upadku, a); C0_x = zaczep * CFrame.new(pos) * CFrame.fromOrientation(rot w radianach); po klipie z powrotem korekta chwytu",
  "grupy": {
   "prawa": {
    "zaczep": "KosturAttachment",
    "kosc": "StaffPivot",
    "od_klatki": 22,
    "do_klatki": 33,
    "ulozenie": "broń wypada z łapy w kl. 22 (jak kostur Kota-Maga) i w locie obraca się do ułożenia kostura: leży płasko przed kotem, oś broni poziomo wzdłuż leżącego kota, lico (+Z) do ziemi, rękojeść w miejscu lądowania kostura (kl. 33), podniesiona tak, żeby najniższy punkt był 0,02 nad ziemią"
   },
   "helm": {
    "zaczep": "KapeluszAttachment",
    "kosc": "HatPivot",
    "od_klatki": 30,
    "do_klatki": 40,
    "ulozenie": "hełm zsuwa się z głowy w kl. 30 (jak kapelusz Kota-Maga) i w locie prostuje się: stoi na ziemi obok głowy kopułą do góry (obrót wokół pionu jak kapelusz, −30°), odsunięty od głowy, najniższy punkt 0,02 nad ziemią; okno przejścia (domyślnie kl. 30→40) dobiera budowa dla każdego hełmu — krótsze, gdy hełm szybciej schodzi z głowy"
   },
   "lewa": {
    "zaczep": "LeftGripAttachment",
    "kosc": "LeftHand",
    "od_klatki": 20,
    "do_klatki": 32,
    "ulozenie": "lewa łapa nie ma kości nośnej: przedmiot zostaje przy łapie i w czasie upadania (domyślnie kl. 20, kolana miękną, → kl. 32, kot leży; okno dobiera budowa tak, żeby w żadnej klatce nie zszedł pod ziemię) kładzie się płasko na ziemi pod łapą (najcieńszą osią pionowo), skręcony wokół pionu tak, żeby jak najmniej wchodził w leżącego kota; tylko przedmiot, który w stałym chwycie schodzi pod ziemię"
   }
  }
 },
